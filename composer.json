{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "barryvdh/laravel-dompdf": "^0.9|^2.0",
        "barryvdh/laravel-snappy": "^0.4.6|^1.0",
        "brick/math": "^0.8.15|^0.9|^0.10",
        "doctrine/dbal": "^2.13.3|^3.1.4",
        "erusev/parsedown-extra": "^0.8.1",
        "fideloper/proxy": "^4.4",
        "garygreen/pretty-routes": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "h4cc/wkhtmltopdf-amd64": "0.12.x",
        "illuminatech/balance": "^1.1",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^8.75",
        "laravel/legacy-factories": "^1.1",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.0",
        "laravelcollective/html": "^6.2",
        "livewire/livewire": "^2.0",
        "predis/predis": "^3.6",
        "rappasoft/laravel-livewire-tables": "^1.0.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "spatie/laravel-activitylog": "^3.17",
        "spatie/laravel-medialibrary": "^9.0",
        "spatie/laravel-permission": "^4.0",
        "staudenmeir/eloquent-has-many-deep": "^1.13",
        "staudenmeir/eloquent-json-relations": "^1.4",
        "symfony/browser-kit": "^5.0",
        "yajra/laravel-datatables-buttons": "^4.10",
        "yajra/laravel-datatables-html": "^4.10",
        "yajra/laravel-datatables-oracle": "^9.15"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
