{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^2.1|^3.0",
        "barryvdh/laravel-snappy": "^1.0",
        "brick/math": "^0.9|^0.10|^0.11|^0.12",
        "doctrine/dbal": "^3.5.1|^4.0",
        "erusev/parsedown-extra": "^0.8.1",
        "garygreen/pretty-routes": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "h4cc/wkhtmltopdf-amd64": "0.12.x",
        "illuminatech/balance": "^1.1",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^11.0",
        "laravel/legacy-factories": "^1.1",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "laravellux/html": "^7.0",
        "livewire/livewire": "^3.0",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^3.6",
        "rappasoft/laravel-livewire-tables": "^3.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "staudenmeir/eloquent-has-many-deep": "^1.20",
        "staudenmeir/eloquent-json-relations": "^1.11",
        "symfony/browser-kit": "^6.0|^7.0",
        "yajra/laravel-datatables-buttons": "^11.0",
        "yajra/laravel-datatables-html": "^11.0",
        "yajra/laravel-datatables-oracle": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "serve": [
            "@php artisan serve --no-reload --port=8001"
        ]
    }
}
